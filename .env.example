# ---- LLM (any OpenAI-compatible endpoint; DeepSeek by default) ----
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# USD per million tokens - fill in from your provider's price list to get real cost metrics
LLM_PRICE_IN_PER_MTOK=0.27
LLM_PRICE_OUT_PER_MTOK=1.10

# ---- Embeddings (OpenAI or Azure OpenAI). Empty key => BM25-only degraded mode ----
EMBED_PROVIDER=openai          # openai | azure
EMBED_BASE_URL=                # Azure: https://<resource>.openai.azure.com
EMBED_API_KEY=
EMBED_MODEL=text-embedding-3-small
EMBED_DIMENSIONS=1536

# ---- Optional local models (need requirements-ml.txt; leave empty to use the LLM judge only) ----
NLI_MODEL=                     # e.g. MoritzLaurer/mDeBERTa-v3-base-mnli-xnli
RERANK_MODEL=                  # e.g. BAAI/bge-reranker-v2-m3

# ---- Storage ----
MONGO_URI=mongodb://mongo:27017
MONGO_DB=doctalk
QDRANT_URL=http://qdrant:6333
FILES_DIR=/data/files

# ---- Auth: dev (local issuer) | entra (Microsoft Entra ID) ----
AUTH_MODE=dev
ENTRA_TENANT_ID=
ENTRA_AUDIENCE=                # api://<app-id>
ENTRA_REQUIRED_SCOPE=access_as_user
ADMIN_ROLE=DocTalk.Admin

# ---- Behaviour (defaults shown) ----
MAX_DOCS_PER_USER=5
MAX_FILE_MB=20
TOP_K=8
CHUNK_MAX_TOKENS=256
CHUNK_MIN_TOKENS=80
CHUNK_OVERLAP_SENTENCES=1
GATE_MIN_VECTOR_SCORE=0.25
GATE_MIN_RERANK_SCORE=0.05
GATE_MIN_LEXICAL_COVERAGE=0.5
RATE_LIMIT_ASK_PER_MIN=20
RATE_LIMIT_UPLOAD_PER_MIN=10
LOG_TEXT=false                 # true stores question/answer text in request logs (privacy!)
LOG_TTL_DAYS=90

# ---- Azure Key Vault (production): secrets named LLM-API-KEY, EMBED-API-KEY, ... are loaded ----
# KEY_VAULT_URL=https://<vault>.vault.azure.net
